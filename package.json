{
  "name": "flashcard-genius-obsidian",
  "private": true,
  "version": "1.0.3",
  "description": "Standalone source repository for the Flashcard Genius Obsidian community plugin.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts && node --test scripts/release.test.mjs",
    "dev:preview": "vite --config web/vite.config.ts",
    "build:preview": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "test:browser": "playwright test",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "npm run release:check && npm test && npm run typecheck && npm run typecheck:web && npm run build:preview && npm run build && npm run release:check -- --build && npm run test:browser"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@flashcard-genius/core": "1.0.3",
    "@flashcard-genius/ui": "1.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  }
}
