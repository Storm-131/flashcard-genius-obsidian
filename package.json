{
  "name": "flashcard-genius-obsidian",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone source repository for the Flashcard Genius Obsidian community plugin.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@flashcard-genius/core": "1.0.0",
    "@flashcard-genius/ui": "1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
